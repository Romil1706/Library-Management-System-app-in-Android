<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
   xmlns:android="http://schemas.android.com/apk/res/android"
   xmlns:app="http://schemas.android.com/apk/res-auto"
   xmlns:tools="http://schemas.android.com/tools"
   android:layout_width="match_parent"
   android:layout_height="match_parent">

   <TextView
       android:id="@+id/title"
       android:layout_width="wrap_content"
       android:layout_height="wrap_content"
       android:text="Library Admin"
       android:textSize="26sp"
       android:textStyle="bold"
       app:layout_constraintBottom_toBottomOf="parent"
       app:layout_constraintEnd_toEndOf="parent"
       app:layout_constraintStart_toStartOf="parent"
       app:layout_constraintTop_toTopOf="parent"
       app:layout_constraintVertical_bias="0.083" />

   <Button
       android:id="@+id/searchPageBtn"
       style="@style/RoundedButton"
       android:layout_width="0dp"
       android:layout_height="wrap_content"
       android:layout_margin="20dp"
       android:text="Search Book"
       app:layout_constraintBottom_toBottomOf="parent"
       app:layout_constraintEnd_toEndOf="parent"
       app:layout_constraintHorizontal_bias="0.4"
       app:layout_constraintStart_toStartOf="parent"
       app:layout_constraintTop_toBottomOf="@id/title"
       app:layout_constraintVertical_bias="0.109" />

   <Button
       android:id="@+id/finePageBtn"
       style="@style/RoundedButton"
       android:layout_width="0dp"
       android:layout_height="wrap_content"
       android:layout_marginHorizontal="20dp"
       android:layout_marginTop="20dp"
       android:text="Late Returns"
       app:layout_constraintBottom_toBottomOf="parent"
       app:layout_constraintEnd_toEndOf="parent"
       app:layout_constraintStart_toStartOf="parent"
       app:layout_constraintTop_toBottomOf="@id/searchPageBtn"
       app:layout_constraintVertical_bias="0.006" />

   <Button
       android:id="@+id/goToUpdateBtn"
       style="@style/RoundedButton"
       android:layout_width="0dp"
       android:layout_height="wrap_content"
       android:layout_margin="20dp"
       android:text="Send Update"
       app:layout_constraintBottom_toBottomOf="parent"
       app:layout_constraintEnd_toEndOf="parent"
       app:layout_constraintStart_toStartOf="parent"
       app:layout_constraintTop_toBottomOf="@id/finePageBtn"
       app:layout_constraintVertical_bias="0.032" />

   <Button
       android:id="@+id/logoutBtn"
       style="@style/RoundedButton"
       android:layout_width="202dp"
       android:layout_height="66dp"
       android:layout_margin="20dp"
       android:layout_marginTop="24dp"
       android:text="Logout"
       app:layout_constraintBottom_toBottomOf="parent"
       app:layout_constraintEnd_toEndOf="parent"
       app:layout_constraintStart_toStartOf="parent"
       app:layout_constraintTop_toBottomOf="@id/goToUpdateBtn"
       app:layout_constraintVertical_bias="0.218" />

</androidx.constraintlayout.widget.ConstraintLayout>
